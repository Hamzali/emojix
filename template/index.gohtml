{{ define "styles" }}
  <link rel="stylesheet" href="/static/style/index.css" />
{{ end }}

{{ define "base" }}
  <div class="root">
    <header class="header">
      <h1 class="brand-title">Emojix</h1>
      <p class="tagline">pick, tell, guess</p>
    </header>

    <main class="content">
      <div class="window">
        <div class="bar">Welcome, <em>{{ .Nickname }}</em></div>

        <div class="window-content">
          <div class="form">
            <form method="post" action="/game/new" class="new-game-form">
              <label for="list-id">Word list</label>
              <select id="list-id" name="list-id" required>
                {{ range .Lists }}
                  <option value="{{ .ID }}">{{ .Title }}</option>
                {{ end }}
              </select>
              <button type="submit">New game</button>
            </form>

            <div class="form-divider" aria-hidden="true">or</div>

            <form method="get" action="/game/join" class="join-form">
              <label for="game-id">Game code</label>
              <input
                id="game-id"
                name="game-id"
                placeholder="Paste game code"
                autocomplete="off"
                required
              />
              <button type="submit">Join game</button>
            </form>
          </div>
        </div>
      </div>
    </main>

    <footer class="footer">
      created by <a href="https://tha.sh">thash</a>
    </footer>
  </div>
{{ end }}
