{{ define "leaderboard" }}
  {{ if .Leaderboard }}
  <ul>
    {{ range .Leaderboard }}
      <li>
        <span>
          {{ if .Me }}
            <strong>{{ .Nickname }}</strong>
          {{ else }}
            {{ .Nickname }}
          {{ end }}
        </span>
        <span>{{ if .GuessedWord }}✅{{ end }}</span>
        <span class="score">{{ .Score }}</span>
      </li>
    {{ end }}
  </ul>
  {{ else }}
  <p class="empty">Waiting for players…</p>
  {{ end }}
{{ end }}
