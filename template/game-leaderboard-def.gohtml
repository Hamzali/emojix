{{ define "leaderboard" }}
  {{ if .Leaderboard }}
  <ul class="player-list">
    {{ range .Leaderboard }}
      <li class="player{{ if .Me }} is-me{{ end }}{{ if .GuessedWord }} is-guessed{{ end }}">
        <span class="player-name">
          {{ if .Me }}
            <strong>{{ .Nickname }}</strong>
          {{ else }}
            {{ .Nickname }}
          {{ end }}
        </span>
        <span class="player-status">{{ if .GuessedWord }}✓{{ end }}</span>
        <span class="score">{{ .Score }}</span>
      </li>
    {{ end }}
  </ul>
  {{ else }}
  <p class="empty">Waiting for players</p>
  {{ end }}
{{ end }}
