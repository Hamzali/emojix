{{ define "styles" }}
  <link rel="stylesheet" href="/static/style/game.css" />
{{ end }}

{{ define "base" }}
  <div class="root" hx-ext="sse" sse-connect="/game/{{ .GameID }}/sse">
    <aside class="sidebar">
      <div class="window leaderboard">
        <div class="actions">
          <a class="btn" href="/">Home</a>
          <button
            type="button"
            class="btn"
            id="copy-game-id"
            data-game-id="{{ .GameID }}"
          >
            Copy code
          </button>
        </div>
        <div class="window-content">
          <section
            hx-get="/game/{{ .GameID }}/leaderboard"
            hx-trigger="sse:left,sse:join,sse:guessed,guessed from:body"
          >
            {{ template "leaderboard" . }}
          </section>
        </div>
      </div>
    </aside>

    <main class="main">
      <div class="window word-panel">
        <div class="window-content">
          {{ if .AwaitingPick }}
            {{ if .IsTeller }}
              <p class="pick-prompt">Pick a word to tell</p>
              <div class="word-options">
                {{ range .WordOptions }}
                  <form method="post" action="/game/{{ $.GameID }}/pick">
                    <input type="hidden" name="word-id" value="{{ .ID }}" />
                    <button type="submit" class="word-option">
                      <span class="word-option-text">{{ .Word }}</span>
                      <span class="word-option-hint">{{ .Hint }}</span>
                    </button>
                  </form>
                {{ end }}
              </div>
            {{ else }}
              <p class="pick-wait">Waiting for the teller to pick a word…</p>
            {{ end }}
          {{ else }}
          <div class="emoji-display">
            {{ .EmojiHint }}
          </div>
          <div class="turn-timer">
            <div class="turn-timer-bar" data-start="{{ .TurnStartedAt.UnixMilli }}"></div>
          </div>
          <div
            class="word-display"
            hx-get="/game/{{ .GameID }}/word"
            hx-trigger="guessed from:body"
          >
            {{ template "game-word" . }}
          </div>
          {{ if not .IsTeller }}
          <form
            class="guess-form"
            hx-post="/game/{{ .GameID }}/guess"
            hx-target="#messages"
            hx-swap="afterbegin"
            hx-on:htmx:after-request="event.target.reset()"
          >
            <textarea
              name="content"
              placeholder="Type your guess…"
              rows="1"
              required
            ></textarea>
            <button type="submit">Guess</button>
          </form>
          {{ else }}
            <p class="teller-note">You're the teller — others are guessing.</p>
          {{ end }}
          {{ end }}
        </div>
      </div>

      <div class="window chat-panel">
        <div class="window-content">
          <section
            id="messages"
            class="messages"
            sse-swap="msg"
            hx-swap="afterbegin"
          >
            {{ range .Messages }}
              {{ template "game-msg" . }}
            {{ end }}
          </section>
          <form
            class="chat-form"
            hx-post="/game/{{ .GameID }}/message"
            hx-target="#messages"
            hx-swap="afterbegin"
            hx-on:htmx:after-request="event.target.reset()"
          >
            <textarea
              name="content"
              placeholder="Send a message…"
              rows="1"
              required
            ></textarea>
            <button type="submit">Send</button>
          </form>
        </div>
      </div>
    </main>

    <div hx-trigger="sse:turnended"></div>
    <script>
      document.body.addEventListener("sse:turnended", () => location.reload());
      document.body.addEventListener("sse:wordpicked", () => location.reload());
      document.body.addEventListener("sse:newturn", () => location.reload());

      (function initCopy() {
        const btn = document.getElementById("copy-game-id");
        if (!btn) return;
        const label = btn.textContent;
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.gameId);
            btn.textContent = "Copied";
            btn.classList.add("is-copied");
            setTimeout(() => {
              btn.textContent = label;
              btn.classList.remove("is-copied");
            }, 1500);
          } catch (_) {
            btn.textContent = "Copy failed";
            setTimeout(() => { btn.textContent = label; }, 1500);
          }
        });
      })();

      (function initTimer() {
        const TURN_DURATION = 60000;
        const bar = document.querySelector(".turn-timer-bar");
        if (!bar) return;

        const startMs = parseInt(bar.dataset.start, 10);
        if (isNaN(startMs)) return;

        function update() {
          const remaining = Math.max(0, TURN_DURATION - (Date.now() - startMs));
          const fraction = remaining / TURN_DURATION;
          bar.style.width = fraction * 100 + "%";

          if (fraction > 0.5) {
            bar.style.backgroundColor = "var(--ui-green)";
          } else if (fraction > 0.25) {
            bar.style.backgroundColor = "var(--ui-yellow)";
          } else {
            bar.style.backgroundColor = "var(--ui-red)";
          }

          if (fraction > 0) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      })();
    </script>
  </div>
{{ end }}
